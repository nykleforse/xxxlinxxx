<?xml version="1.0" encoding="utf-8"?>
<!--
    Deny ALL backup paths. App holds E2EE private keys, FCM tokens, and
    plaintext chat logs in SharedPreferences; auto-backup would exfiltrate
    them to Google Drive / device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
