<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black"
    tools:context=".MainActivity">

    <!-- ═══════════════════════════  MAIN CONTENT  ═══════════════════════════ -->
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- PHOTO AUTH -->
        <LinearLayout
            android:id="@+id/photoAuthScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X-link"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/photoAuthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select photo, then enter password"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnChooseAuthPhoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/control"
                android:text="Choose photo"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/authPhotoChosen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="✓ Photo loaded" />

            <EditText
                android:id="@+id/authPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/line"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnLoginWithPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/control"
                android:enabled="false"
                android:text="Log in"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Your photo + password derive the account locally.\nNeither leaves the device."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- CONTACT LIST -->
        <LinearLayout
            android:id="@+id/contactListScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header: hamburger + title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#9776;"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Chats"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUnreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:minWidth="22dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge"
                    android:textColor="@color/oled_black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/line" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/contactsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <Button
                android:id="@+id/btnOpenAddContact"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_add_contact_fab"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- ADD CONTACT -->
        <LinearLayout
            android:id="@+id/addContactScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBackFromAddContact"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/control"
                    android:text="Back"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="New chat"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/addContactIdInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/line"
                android:hint="Contact ID"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/addContactNameInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/line"
                android:hint="Local name"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/btnAddContact"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/control"
                android:text="Add"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- CHAT -->
        <LinearLayout
            android:id="@+id/chatScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/control"
                    android:text="Back"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/chatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Alex" />

                    <TextView
                        android:id="@+id/chatPeerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="4C024A76" />
                </LinearLayout>

                <!-- Inline "+ Add" pill: appears only when peer is not in saved contacts.
                     Sits in the top bar so it never collides with the title or other actions. -->
                <Button
                    android:id="@+id/btnBannerAddContact"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_add_pill"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+ Add"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#128269;"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnCall"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Call"
                    android:padding="12dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_phone_24" />
            </LinearLayout>

            <!-- Legacy banner kept hidden — code references it but no longer renders.
                 Will remove after all callers migrate. -->
            <LinearLayout
                android:id="@+id/addContactBanner"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bannerContactId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callControls"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:text="Accept"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:text="End"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="CONNECTED" />

            <!-- Search bar (hidden by default) -->
            <LinearLayout
                android:id="@+id/chatSearchBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/chatSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/line"
                    android:hint="Search messages..."
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />

                <Button
                    android:id="@+id/btnClearSearch"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#10005;"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/messagesScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/messagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"/>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAttachPhoto"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="📎"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/line"
                    android:hint="Message"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="^"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- INCOMING CALL -->
        <LinearLayout
            android:id="@+id/incomingCallScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/oled_black"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Incoming call"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/incomingCallerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Alex" />

            <TextView
                android:id="@+id/incomingCallerId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="4C024A76" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeclineIncoming"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:text="Decline"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnAcceptIncoming"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:text="Accept"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- OUTGOING CALL -->
        <LinearLayout
            android:id="@+id/outgoingCallScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/oled_black"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Calling"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/outgoingCallName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Alex" />

            <TextView
                android:id="@+id/outgoingCallCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="30"
                android:textColor="@color/text_primary"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="seconds"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCancelOutgoingCall"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="42dp"
                android:backgroundTint="@color/control"
                android:text="Cancel"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- ACTIVE CALL -->
        <LinearLayout
            android:id="@+id/activeCallScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/oled_black"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/callTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/activeCallName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Alex" />

            <TextView
                android:id="@+id/activeCallStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Connecting"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMuteMic"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:text="Mic"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnToggleSpeaker"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:text="Speaker"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnEndActiveCall"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/control"
                    android:minWidth="0dp"
                    android:text="End"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- PIN LOCK SCREEN (overlay — must be last child so it renders on top) -->
        <LinearLayout
            android:id="@+id/lockScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/oled_black"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="X-link"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lockStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Enter PIN to unlock"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/line"
                android:gravity="center"
                android:hint="PIN"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="180dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/control"
                android:text="Unlock"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnUseBiometric"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/control"
                android:text="Use biometric"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

    <!-- ═══════════════════════════  SIDE DRAWER  ════════════════════════════ -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/oled_black"
        android:orientation="vertical">

        <!-- Profile card (header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF111111"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X-link"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDrawerClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#10005;"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="YOUR ID"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/myId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="7F31A2C0" />

                <ImageButton
                    android:id="@+id/btnCopyMyId"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy ID"
                    android:padding="10dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_copy_24" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scrollable menu items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- Section: Account -->
                <TextView
                    style="@style/DrawerSection"
                    android:text="Account" />

                <LinearLayout
                    android:id="@+id/btnDrawerShowQr"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#9633;" />
                    <TextView style="@style/DrawerItemText" android:text="Show my QR" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDrawerScanQr"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#9678;" />
                    <TextView style="@style/DrawerItemText" android:text="Scan QR code" />
                </LinearLayout>

                <!-- Section: Data -->
                <TextView
                    style="@style/DrawerSection"
                    android:text="Data" />

                <LinearLayout
                    android:id="@+id/btnExportBackup"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#8595;" />
                    <TextView style="@style/DrawerItemText" android:text="Backup" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnImportBackup"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#8593;" />
                    <TextView style="@style/DrawerItemText" android:text="Restore" />
                </LinearLayout>

                <!-- Section: Updates -->
                <TextView
                    style="@style/DrawerSection"
                    android:text="Updates" />

                <LinearLayout
                    android:id="@+id/btnCheckUpdates"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#8635;" />
                    <TextView style="@style/DrawerItemText" android:text="Check for updates" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCheckBeta"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#946;" />
                    <TextView style="@style/DrawerItemText" android:text="Check beta" />
                </LinearLayout>

                <!-- Section: Security -->
                <TextView
                    style="@style/DrawerSection"
                    android:text="Security" />

                <LinearLayout
                    android:id="@+id/btnAppLock"
                    style="@style/DrawerItem">
                    <TextView style="@style/DrawerItemIcon" android:text="&#9737;" />
                    <TextView
                        android:id="@+id/btnAppLockText"
                        style="@style/DrawerItemText"
                        android:text="App lock: OFF" />
                </LinearLayout>

                <!-- Section: Account actions -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/btnLogout"
                    style="@style/DrawerItem">
                    <TextView
                        style="@style/DrawerItemIcon"
                        android:text="&#8635;"
                        android:textColor="#FF8A8A" />
                    <TextView
                        style="@style/DrawerItemText"
                        android:text="Log out / Change account"
                        android:textColor="#FF8A8A" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
