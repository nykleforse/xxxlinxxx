rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isShortId(value) {
      return value is string && value.matches('^[A-Z0-9]{4,32}$');
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(field, maxLength) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        isNonEmptyString(request.resource.data[field], maxLength);
    }

    function isClientMillis(value) {
      return value is int && value > 0;
    }

    function callParticipant(data) {
      return isShortId(data.callerId) &&
        isShortId(data.calleeId) &&
        data.callerId != data.calleeId;
    }

    // ── v2 helpers ───────────────────────────────────────────────────────
    // Custom claim `localId` is set by the bindLocalId Cloud Function after
    // verifying the caller's ECDSA signature against the photo+password key.
    // hasLocalIdClaim() == false → legacy client, fall back to old rules
    // (grace period only — remove fallbacks once all clients update).
    function hasLocalIdClaim() {
      return request.auth != null && 'localId' in request.auth.token;
    }
    function localIdClaim() {
      return request.auth.token.localId;
    }

    // ── /bindings/{localId} ──────────────────────────────────────────────
    // Read: anyone authenticated (need pubkey to encrypt to a new contact).
    // Write: ONLY via Cloud Function (admin bypasses rules).
    match /bindings/{localId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get, list: if true;

      allow create, update: if isShortId(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.keys().hasOnly([
          'id',
          'messagePublicKey',
          'keyAlgorithm',
          'updatedAt',
          'fcmToken',
          'fcmUpdatedAt'
        ]) &&
        isOptionalString('messagePublicKey', 4096) &&
        isOptionalString('keyAlgorithm', 64) &&
        isOptionalString('fcmToken', 4096) &&
        (!('updatedAt' in request.resource.data) || isClientMillis(request.resource.data.updatedAt)) &&
        (!('fcmUpdatedAt' in request.resource.data) || isClientMillis(request.resource.data.fcmUpdatedAt)) &&
        (!hasLocalIdClaim() || localIdClaim() == userId);

      allow delete: if false;
    }

    match /photoAccounts/{accountId} {
      allow get: if accountId.matches('^[a-f0-9]{64}$');
      allow list, create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow get, list: if hasLocalIdClaim() &&
        localIdClaim() == resource.data.to;

      allow create: if request.resource.data.keys().hasOnly([
          'from',
          'to',
          'encryptedKey',
          'iv',
          'cipherText',
          'messageAlgorithm',
          'keyAlgorithm',
          'createdAt',
          'groupId',
          'replyTo'
        ]) &&
        isShortId(request.resource.data.from) &&
        isShortId(request.resource.data.to) &&
        request.resource.data.from != request.resource.data.to &&
        isNonEmptyString(request.resource.data.encryptedKey, 4096) &&
        isNonEmptyString(request.resource.data.iv, 256) &&
        isNonEmptyString(request.resource.data.cipherText, 16384) &&
        request.resource.data.messageAlgorithm == 'AES/GCM/NoPadding' &&
        isNonEmptyString(request.resource.data.keyAlgorithm, 128) &&
        isClientMillis(request.resource.data.createdAt) &&
        isOptionalString('groupId', 128) &&
        isOptionalString('replyTo', 256) &&
        (!hasLocalIdClaim() || localIdClaim() == request.resource.data.from);

      allow update: if false;
      // Retained inbox cleanup is performed by the Admin SDK scheduled function.
      // Clients cannot consume/delete a message before another device sees it.
      allow delete: if false;
    }

    match /calls/{callId} {
      allow get, list: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'sessionId',
          'callerId',
          'calleeId',
          'offer',
          'mode',
          'state',
          'createdAt'
        ]) &&
        callParticipant(request.resource.data) &&
        isNonEmptyString(request.resource.data.sessionId, 128) &&
        isNonEmptyString(request.resource.data.offer, 327680) &&
        request.resource.data.mode in ['comfy', 'base', 'Xtream'] &&
        request.resource.data.state == 'ringing' &&
        isClientMillis(request.resource.data.createdAt) &&
        (!hasLocalIdClaim() || localIdClaim() == request.resource.data.callerId);

      allow update: if callParticipant(resource.data) &&
        request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.calleeId == resource.data.calleeId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.keys().hasOnly([
          'sessionId',
          'callerId',
          'calleeId',
          'offer',
          'mode',
          'state',
          'createdAt',
          'answer',
          'answerMode',
          'answerSessionId',
          'answeredAt',
          'endedBy',
          'endedSessionId',
          'endedReason',
          'endedAt',
          'declinedBy',
          'declinedSessionId'
        ]) &&
        request.resource.data.state in ['ringing', 'answered', 'ended', 'declined'] &&
        isOptionalString('answer', 327680) &&
        isOptionalString('answerMode', 32) &&
        isOptionalString('answerSessionId', 128) &&
        isOptionalString('endedBy', 32) &&
        isOptionalString('endedSessionId', 128) &&
        isOptionalString('endedReason', 64) &&
        isOptionalString('declinedBy', 32) &&
        isOptionalString('declinedSessionId', 128) &&
        (!('answeredAt' in request.resource.data) || isClientMillis(request.resource.data.answeredAt)) &&
        (!('endedAt' in request.resource.data) || isClientMillis(request.resource.data.endedAt)) &&
        (!hasLocalIdClaim() ||
          localIdClaim() == resource.data.callerId ||
          localIdClaim() == resource.data.calleeId);

      allow delete: if false;

      match /candidates/{candidateId} {
        allow get, list: if true;

        allow create: if request.resource.data.keys().hasOnly([
            'sessionId',
            'sender',
            'sdpMid',
            'sdpMLineIndex',
            'candidate'
          ]) &&
          isNonEmptyString(request.resource.data.sessionId, 128) &&
          isShortId(request.resource.data.sender) &&
          isOptionalString('sdpMid', 64) &&
          request.resource.data.sdpMLineIndex is int &&
          request.resource.data.sdpMLineIndex >= 0 &&
          isNonEmptyString(request.resource.data.candidate, 4096) &&
          (!hasLocalIdClaim() || localIdClaim() == request.resource.data.sender);

        allow update, delete: if false;
      }
    }

    match /receipts/{msgId} {
      allow get, list: if true;

      allow create: if request.resource.data.keys().hasOnly([
            'from', 'to', 'delivered', 'read', 'createdAt'
          ]) &&
        isShortId(request.resource.data.from) &&
        isShortId(request.resource.data.to) &&
        request.resource.data.from != request.resource.data.to &&
        request.resource.data.delivered == true &&
        request.resource.data.read == false &&
        isClientMillis(request.resource.data.createdAt) &&
        (!hasLocalIdClaim() || localIdClaim() == request.resource.data.from);

      allow update: if resource.data.delivered == true &&
        resource.data.read == false &&
        request.resource.data.read == true &&
        request.resource.data.delivered == resource.data.delivered &&
        request.resource.data.from == resource.data.from &&
        request.resource.data.to == resource.data.to &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!hasLocalIdClaim() || localIdClaim() == resource.data.from);

      allow delete: if isShortId(resource.data.to) &&
        (!hasLocalIdClaim() || localIdClaim() == resource.data.to);
    }

    match /transfers/{transferId} {
      allow get, list: if true;

      allow create: if request.resource.data.keys().hasOnly([
            'transferId',
            'senderId',
            'receiverId',
            'offer',
            'state',
            'createdAt'
          ]) &&
        request.resource.data.transferId == transferId &&
        isNonEmptyString(request.resource.data.transferId, 128) &&
        isShortId(request.resource.data.senderId) &&
        isShortId(request.resource.data.receiverId) &&
        request.resource.data.senderId != request.resource.data.receiverId &&
        isNonEmptyString(request.resource.data.offer, 327680) &&
        request.resource.data.state == 'pending' &&
        isClientMillis(request.resource.data.createdAt) &&
        (!hasLocalIdClaim() || localIdClaim() == request.resource.data.senderId);

      allow update: if resource.data.transferId == transferId &&
        request.resource.data.transferId == resource.data.transferId &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.offer == resource.data.offer &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.keys().hasOnly([
          'transferId',
          'senderId',
          'receiverId',
          'offer',
          'state',
          'createdAt',
          'answer'
        ]) &&
        request.resource.data.state in [
          'pending',
          'accepted',
          'done',
          'failed',
          'expired',
          'rejected',
          'rejected_busy'
        ] &&
        isOptionalString('answer', 327680) &&
        (!hasLocalIdClaim() ||
          localIdClaim() == resource.data.senderId ||
          localIdClaim() == resource.data.receiverId);

      allow delete: if false;

      match /candidates/{candidateId} {
        allow get, list: if true;

        allow create: if request.resource.data.keys().hasOnly([
            'sender',
            'sdpMid',
            'sdpMLineIndex',
            'candidate'
          ]) &&
          isShortId(request.resource.data.sender) &&
          isOptionalString('sdpMid', 64) &&
          request.resource.data.sdpMLineIndex is int &&
          request.resource.data.sdpMLineIndex >= 0 &&
          isNonEmptyString(request.resource.data.candidate, 4096) &&
          (!hasLocalIdClaim() || localIdClaim() == request.resource.data.sender);

        allow update, delete: if false;
      }
    }

    // ── /groups/{groupId} ────────────────────────────────────────────────
    // Lightweight group metadata: name + member list + admin. The members
    // list is what every client reads to discover the group on a new device.
    match /groups/{groupId} {
      allow get, list: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
            'name', 'members', 'adminId', 'createdAt'
          ]) &&
        isNonEmptyString(request.resource.data.name, 128) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() <= 100 &&
        isShortId(request.resource.data.adminId) &&
        isClientMillis(request.resource.data.createdAt) &&
        (!hasLocalIdClaim() || localIdClaim() == request.resource.data.adminId);

      // Only the admin can mutate the group (rename, add/remove members).
      allow update: if request.resource.data.adminId == resource.data.adminId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.members is list &&
        request.resource.data.members.size() <= 100 &&
        (!hasLocalIdClaim() || localIdClaim() == resource.data.adminId);

      allow delete: if (!hasLocalIdClaim() || localIdClaim() == resource.data.adminId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
